# --icons takes an optional value, so pass it with `=` or the next
# argument (e.g. `ls share`) gets parsed as the icon mode.
alias ls='eza --icons=auto'
alias cat='bat'

alias gl='git log'
alias gb='git branch'
alias gs='git status'
alias gr='git restore'
alias gd='git diff'
alias gpl='git pull'
alias gfc='git fetch'
alias gswc='git switch --create'
alias gpsc='git push origin HEAD'
alias gpsuc='git push -u origin HEAD'
