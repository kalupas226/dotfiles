[ghq]
  vcs = git
  root = ~/Development
[user]
  email = 22762894+kalupas226@users.noreply.github.com
  name = kalupas226
[pull]
  rebase = false
[core]
  editor = nvim
  excludesfile = ~/.gitignore.global
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[include]
  path = ~/.gitconfig.local
